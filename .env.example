# WordPress base URL (no trailing slash), e.g. https://cms.androiddreamsmedia.com
# When unset, the site runs in preview mode with built-in sample content.
NEXT_PUBLIC_WP_API_URL=

# Public site URL used for canonical links, Open Graph, RSS, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://androiddreamsmedia.com

# beehiiv newsletters — two publications, one API key (same workspace).
# AD = The Sunday Letter (the Android Dreams newsletter)
# QF = The Dev Brief (the QFrontline newsletter)
NEXT_PUBLIC_BEEHIIV_AD_PUBLICATION_ID=
NEXT_PUBLIC_BEEHIIV_QF_PUBLICATION_ID=
BEEHIIV_API_KEY=

# Quantum Readiness Community destinations. When unset, the site shows
# "request an invite" flows instead of direct links.
NEXT_PUBLIC_QRC_DISCORD_URL=
NEXT_PUBLIC_QRC_LINKEDIN_URL=

# Contact Form 7 form IDs on the WordPress install (numeric IDs).
WP_CF7_DAVOS_FORM_ID=
WP_CF7_CONTACT_FORM_ID=
# QRC invite requests (falls back to the contact form if unset)
WP_CF7_QRC_FORM_ID=
